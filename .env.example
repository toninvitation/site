# =========================================================
# TONInvitation — EXEMPLO DE VARIÁVEIS DE AMBIENTE
#
# NÃO coloques estes valores no GitHub.
# Copia este ficheiro para .env e preenche os valores reais.
# =========================================================

# ---------------------------------------------------------
# GMAIL
# ---------------------------------------------------------
EMAIL_USER=teu-email@gmail.com
EMAIL_PASSWORD=senha-de-app-do-google
EMAIL_FROM=TONInvitation <teu-email@gmail.com>

# ---------------------------------------------------------
# SHOPIFY — CHECKOUT
# ---------------------------------------------------------
# Domínio myshopify.com da tua loja.
# Exemplo: toninvitation.myshopify.com
SHOPIFY_STORE_DOMAIN=nome-da-tua-loja.myshopify.com

# Token PRIVADO da Storefront API.
# Este valor fica apenas no servidor e NUNCA deve ser colocado
# diretamente em HTML, CSS, JavaScript público ou GitHub.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=COLOCA_AQUI_O_TOKEN_PRIVADO

# Versão estável da Storefront API usada pelo projeto.
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Porta local usada durante os testes.
PORT=3000

# ---------------------------------------------------------
# CORS — ORIGENS AUTORIZADAS
# ---------------------------------------------------------
# Coloca aqui o endereço do GitHub Pages e, quando existir, o domínio final.
# Separa vários endereços por vírgulas.
CORS_ORIGINS=https://toninvitation.github.io,http://localhost:3000

# ---------------------------------------------------------
# REGRESSO AO SITE TONINVITATION APÓS O CHECKOUT
# ---------------------------------------------------------
# URL pública que queremos testar como destino de regresso.
# Exemplo futuro:
# SHOPIFY_RETURN_URL=https://TEU-DOMINIO/order-return.html
#
# Durante o teste local pode ser deixado vazio. O checkout continua a funcionar.
SHOPIFY_RETURN_URL=

# ---------------------------------------------------------
# REGRESSO AO SITE TONINVITATION APÓS O CHECKOUT
# ---------------------------------------------------------
# URL pública que queremos testar como destino de regresso.
# Exemplo futuro:
# SHOPIFY_RETURN_URL=https://TEU-DOMINIO/order-return.html
#
# Durante o teste local pode ser deixado vazio.
SHOPIFY_RETURN_URL=
