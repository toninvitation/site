# =========================================================
# FICHEIROS SECRETOS
# =========================================================

# Impede o envio das variáveis secretas do projeto.
.env

# Impede versões alternativas do ficheiro .env.
.env.*

# Permite apenas ficheiros de exemplo sem passwords.
!.env.example


# =========================================================
# IMAGENS PRIVADAS
# =========================================================

# Impede o envio das imagens sem marca d'água.
Categorias Private/


# =========================================================
# PEDIDOS DOS CLIENTES
# =========================================================

# Impede o envio dos pedidos e dados dos clientes.
data/orders/


# =========================================================
# DEPENDÊNCIAS
# =========================================================

# Impede o envio das dependências instaladas.
node_modules/


# =========================================================
# FICHEIROS TEMPORÁRIOS
# =========================================================

# Impede ficheiros temporários.
*.log

# Impede ficheiros temporários do sistema.
.DS_Store
Thumbs.db